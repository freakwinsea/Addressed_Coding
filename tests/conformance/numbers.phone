phonebook 0.1

# The two contracts that exist because Python and Rust disagree.
#
# DIV truncates toward zero: Python's // would floor and give -4 for the first
# case. MOD takes the dividend's sign: Python's % would give 1 for the second.
# Rust gets both for free. If either backend ever stops bending, this file is
# what notices.

400-0000004@[-7, 2] -> a    # DIV  -> -3, not -4
100-0000001@[a]
400-0000004@[7, -2] -> b    # DIV  -> -3
100-0000001@[b]
400-0000004@[7, 2] -> c     # DIV  ->  3
100-0000001@[c]

400-0000005@[-7, 2] -> d    # MOD  -> -1, not 1
100-0000001@[d]
400-0000005@[7, -2] -> e    # MOD  ->  1
100-0000001@[e]

# a == DIV(a,b)*b + MOD(a,b) must hold for the pair to be coherent.
400-0000003@[a, 2] -> f
400-0000001@[f, d] -> g     # -3*2 + -1 = -7
100-0000001@[g]

400-0000009@["  42 ", 0] -> h      # PARSE_INT, padded
100-0000001@[h]
400-0000009@["1_000", -1] -> i     # underscores rejected
100-0000001@[i]
400-0000009@["n/a", -1] -> j       # fallback, never a fault
100-0000001@[j]
400-0000009@["-42", 0] -> k
100-0000001@[k]

300-0000001@[3, 1, 2] -> nums
400-0000008@[nums] -> total        # SUM
100-0000001@[total]
400-0000006@[3, 9] -> smaller      # MIN
100-0000001@[smaller]
400-0000007@[3, 9] -> larger       # MAX
100-0000001@[larger]

# ABS and NEGATE: Python's abs and unary minus never overflow, Rust's panic or
# wrap. The contract makes the smallest int64 a fault in both; these are the
# values either side of that edge.
400-0000010@[-5] -> l              # ABS
100-0000001@[l]
400-0000010@[-9223372036854775807] -> m
100-0000001@[m]
400-0000011@[5] -> n               # NEGATE
100-0000001@[n]
400-0000011@[9223372036854775807] -> o
100-0000001@[o]

# POW squares step by step in both runtimes. -2 to the 63rd is exactly the
# smallest int64: it fits, even though 2 to the 63rd does not.
400-0000012@[2, 10] -> p           # POW
100-0000001@[p]
400-0000012@[-3, 3] -> q
100-0000001@[q]
400-0000012@[0, 0] -> r            # 1 by contract
100-0000001@[r]
400-0000012@[-2, 63] -> s
100-0000001@[s]
400-0000012@[-1, 9223372036854775807] -> t
100-0000001@[t]

400-0000013@[-5, 0, 10] -> u       # CLAMP, below
100-0000001@[u]
400-0000013@[15, 0, 10] -> v       # above
100-0000001@[v]
400-0000013@[3, 7, 7] -> w         # a one-number range
100-0000001@[w]

400-0000014@[-42] -> x             # SIGN
100-0000001@[x]
400-0000014@[0] -> y
100-0000001@[y]
400-0000014@[42] -> z
100-0000001@[z]
