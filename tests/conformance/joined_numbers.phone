phonebook 0.1

# Joining the number types up. The comparisons in 400-0000060..064 take
# bigint, decimal and fraction as well as int and float, and 400-0000100..105
# cross between the types that had no direct road. Both runtimes do this by
# hand, so this file is where they have to agree.

# Comparisons on bigints, past where an int would fit.
400-0000060@[123456789012345678901234567890n, 123456789012345678901234567890n] -> big_eq
100-0000001@[big_eq]
400-0000061@[123456789012345678901234567890n, 123456789012345678901234567891n] -> big_ne
100-0000001@[big_ne]
400-0000062@[-99999999999999999999999n, 1n] -> big_le
100-0000001@[big_le]
400-0000063@[1n, 1n] -> big_ge
100-0000001@[big_ge]
400-0000064@[-1000000000000000000000n, -999999999999999999999n] -> big_cmp
100-0000001@[big_cmp]

# Decimals compare by value: 0.3 and 0.30 are the same number.
400-0000060@[0.3d, 0.30d] -> dec_eq
100-0000001@[dec_eq]
400-0000061@[0.3d, 0.30d] -> dec_ne
100-0000001@[dec_ne]
400-0000062@[1.999d, 2d] -> dec_le
100-0000001@[dec_le]
400-0000063@[-0.01d, -0.1d] -> dec_ge
100-0000001@[dec_ge]
400-0000064@[2.50d, 2.5d] -> dec_cmp_same
100-0000001@[dec_cmp_same]
400-0000064@[0.0000000001d, 0d] -> dec_cmp
100-0000001@[dec_cmp]

# Fractions are always in lowest terms, so 2/4 and 1/2 are equal.
400-0000080@[1, 2] -> half
400-0000080@[2, 4] -> two_quarters
400-0000080@[1, 3] -> third
400-0000080@[-2, 3] -> neg_two_thirds
400-0000060@[half, two_quarters] -> frac_eq
100-0000001@[frac_eq]
400-0000061@[half, third] -> frac_ne
100-0000001@[frac_ne]
400-0000062@[third, half] -> frac_le
100-0000001@[frac_le]
400-0000063@[neg_two_thirds, third] -> frac_ge
100-0000001@[frac_ge]
400-0000064@[neg_two_thirds, third] -> frac_cmp
100-0000001@[frac_cmp]
400-0000080@[9223372036854775806, 9223372036854775807] -> near_one
400-0000080@[9223372036854775805, 9223372036854775806] -> nearer
400-0000064@[near_one, nearer] -> frac_cmp_close
100-0000001@[frac_cmp_close]

# DEC_TO_BIG truncates toward zero and has no 64-bit ceiling.
400-0000100@[2.99d] -> db1
100-0000001@[db1]
400-0000100@[-2.99d] -> db2
100-0000001@[db2]
400-0000100@[-0.5d] -> db3
100-0000001@[db3]
400-0000100@[123456789012345678901234567890.5d] -> db4
100-0000001@[db4]

# BIG_TO_FLOAT rounds once, ties to even: 2^53 + 1 is 2^53.
400-0000101@[42n] -> bf1
100-0000001@[bf1]
400-0000101@[9007199254740993n] -> bf2
100-0000001@[bf2]
400-0000101@[100000000000000000000000n] -> bf3
100-0000001@[bf3]
400-0000101@[-123456789012345678901234567890n] -> bf4
100-0000001@[bf4]

# FLOAT_TO_BIG takes the float's exact binary value and truncates.
400-0000102@[2.9] -> fb1
100-0000001@[fb1]
400-0000102@[-2.9] -> fb2
100-0000001@[fb2]
400-0000102@[1e23] -> fb3
100-0000001@[fb3]
400-0000102@[-1.8446744073709552e19] -> fb4
100-0000001@[fb4]
400-0000102@[1.7976931348623157e308] -> fb5
100-0000001@[fb5]
400-0000102@[5e-324] -> fb6
100-0000001@[fb6]
400-0000102@[4503599627370495.5] -> fb7
100-0000001@[fb7]

# DEC_TO_FRACTION is exact and reduces.
400-0000103@[0.75d] -> df1
100-0000001@[df1]
400-0000103@[2.50d] -> df2
100-0000001@[df2]
400-0000103@[-0.10d] -> df3
100-0000001@[df3]
400-0000103@[12d] -> df4
100-0000001@[df4]
400-0000103@[0.000000000000000001d] -> df5
100-0000001@[df5]

# FRACTION_TO_DEC rounds once, halves away from zero, to exactly the places asked.
400-0000080@[1, 8] -> eighth
400-0000080@[-1, 8] -> neg_eighth
400-0000080@[1, 4] -> quarter
400-0000104@[third, 4] -> fd1
100-0000001@[fd1]
400-0000104@[eighth, 2] -> fd2
100-0000001@[fd2]
400-0000104@[neg_eighth, 2] -> fd3
100-0000001@[fd3]
400-0000104@[quarter, 3] -> fd4
100-0000001@[fd4]
400-0000104@[neg_two_thirds, 0] -> fd5
100-0000001@[fd5]
400-0000104@[near_one, 25] -> fd6
100-0000001@[fd6]

# BIG_TO_FRACTION is the value over 1.
400-0000105@[7n] -> bq1
100-0000001@[bq1]
400-0000105@[-9223372036854775808n] -> bq2
100-0000001@[bq2]

# A round trip through all three exact types keeps the value.
400-0000103@[19.99d] -> price
400-0000104@[price, 2] -> back
400-0000060@[back, 19.99d] -> round_trip
100-0000001@[round_trip]
