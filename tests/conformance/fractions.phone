phonebook 0.1

# Fractions are exact: an int on top, an int below, always in lowest terms
# with the sign on top. Neither host's own fraction type is used; both
# runtimes reduce by hand, so this file checks they reduce, print, round and
# order the same way, including near the edges of 64 bits.

# Building one reduces it. 2/4 is 1/2; 3/-6 is -1/2; 0/5 is 0; 4/2 is 2.
400-0000080@[2, 4] -> half
100-0000001@[half]
400-0000080@[3, -6] -> neg_half
100-0000001@[neg_half]
400-0000080@[0, 5] -> zero
100-0000001@[zero]
400-0000080@[4, 2] -> two
100-0000001@[two]
400-0000080@[1, 3] -> third
100-0000001@[third]
400-0000080@[1, 10] -> tenth
400-0000080@[2, 10] -> fifth

# Arithmetic is exact: 1/10 + 2/10 is 3/10, where floats give 0.30000000000000004.
400-0000081@[tenth, fifth] -> s1
100-0000001@[s1]
400-0000081@[third, third] -> s2
100-0000001@[s2]
400-0000081@[s2, third] -> s3             # 3/3 is whole, so it prints 1
100-0000001@[s3]
400-0000082@[third, half] -> d1           # 1/3 - 1/2
100-0000001@[d1]
400-0000083@[neg_half, neg_half] -> m1
100-0000001@[m1]
400-0000084@[third, neg_half] -> q1       # 1/3 / -1/2
100-0000001@[q1]
400-0000084@[two, third] -> q2
100-0000001@[q2]
400-0000085@[third] -> n1
100-0000001@[n1]
400-0000086@[d1] -> a1
100-0000001@[a1]

# The parts, after reducing.
400-0000080@[2, -4] -> parts
400-0000087@[parts] -> top
100-0000001@[top]
400-0000088@[parts] -> bottom
100-0000001@[bottom]

# Near the edges. The working is wider than 64 bits in both runtimes, so a
# result that fits after reducing is fine even when the products do not.
400-0000080@[9223372036854775807, 2] -> big
400-0000080@[2, 9223372036854775807] -> small
400-0000083@[big, small] -> one
100-0000001@[one]
400-0000080@[-9223372036854775808, 3] -> most_negative
100-0000001@[most_negative]
400-0000081@[big, big] -> max
100-0000001@[max]
400-0000080@[9223372036854775806, 9223372036854775807] -> near_one
400-0000080@[9223372036854775805, 9223372036854775806] -> nearer
600-0000005@[nearer, near_one] -> near_less
100-0000001@[near_less]

# FLOOR goes toward negative infinity: 7/2 -> 3, -7/2 -> -4 (Rust's / gives -3).
400-0000080@[7, 2] -> seven_halves
400-0000080@[-7, 2] -> neg_seven_halves
400-0000090@[seven_halves] -> f1
100-0000001@[f1]
400-0000090@[neg_seven_halves] -> f2
100-0000001@[f2]
400-0000090@[most_negative] -> f3
100-0000001@[f3]

# ROUND sends halves away from zero: 5/2 -> 3, -5/2 -> -3 (Python's round gives 2, -2).
400-0000080@[5, 2] -> five_halves
400-0000080@[-5, 2] -> neg_five_halves
400-0000091@[five_halves] -> r1
100-0000001@[r1]
400-0000091@[neg_five_halves] -> r2
100-0000001@[r2]
400-0000091@[third] -> r3
100-0000001@[r3]
400-0000080@[-2, 3] -> neg_two_thirds
400-0000091@[neg_two_thirds] -> r4
100-0000001@[r4]
400-0000091@[most_negative] -> r5
100-0000001@[r5]

# To float: one rounding of the exact value. Dividing two floats would round
# 9007199254740993 to 9007199254740992 first and print ...284.5 for the
# fourth one here.
400-0000089@[third] -> t1
100-0000001@[t1]
400-0000089@[neg_half] -> t2
100-0000001@[t2]
400-0000089@[zero] -> t3
100-0000001@[t3]
400-0000080@[9007199254740993, 7] -> odd_big
400-0000089@[odd_big] -> t4
100-0000001@[t4]
400-0000080@[9223372036854775807, 9223372036854775806] -> tiny_gap
400-0000089@[tiny_gap] -> t5
100-0000001@[t5]
400-0000089@[most_negative] -> t6
100-0000001@[t6]
400-0000089@[small] -> t7
100-0000001@[t7]

# PARSE_FRACTION: sign only on top, no spaces around '/', no zero below.
400-0000092@[" -2/4 ", zero] -> p1
100-0000001@[p1]
400-0000092@["+7", zero] -> p2
100-0000001@[p2]
400-0000092@["1 / 3", neg_half] -> p3
100-0000001@[p3]
400-0000092@["1/-3", neg_half] -> p4
100-0000001@[p4]
400-0000092@["1/0", neg_half] -> p5
100-0000001@[p5]
400-0000092@["1.5", neg_half] -> p6
100-0000001@[p6]
400-0000092@["9223372036854775808/2", neg_half] -> p7     # top too big as written
100-0000001@[p7]
400-0000092@["-9223372036854775808/9223372036854775807", neg_half] -> p8
100-0000001@[p8]
400-0000092@["007/014", neg_half] -> p9
100-0000001@[p9]

# Fractions compare by exact value and can be keys.
300-0000001@[half, third, neg_half, two, zero, s1] -> values
300-0000005@[values] -> ordered
100-0000001@[ordered]
600-0000005@[third, half] -> less
100-0000001@[less]
600-0000006@[third, half] -> greater
100-0000001@[greater]
600-0000004@[s3, p2] -> not_same
100-0000001@[not_same]
400-0000080@[7, 1] -> seven
600-0000004@[seven, p2] -> same
100-0000001@[same]
300-0000001@[half, third, half, p1, third, half] -> repeated
300-0000012@[repeated] -> tallies
300-0000013@[tallies] -> counted
100-0000001@[counted]
300-0000008@[repeated] -> distinct
100-0000001@[distinct]
