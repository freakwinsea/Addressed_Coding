phonebook 0.1

ext 000-0000001 QTY_GREATER_THAN_10 (row: map<text,text>) -> bool {
  300-0000014@[row, "qty", "0"] -> qty_str
  400-0000009@[qty_str, 0] -> qty
  600-0000006@[qty, 10] -> result
  return result
}

500-0000003@["experiments/data/inventory.csv"] -> rows
300-0000002@[rows, 000-0000001]                -> filtered_rows
300-0000009@[filtered_rows]                    -> count
300-0000001@["name", "qty"]                    -> columns
