ext 000-0000001 GET_VALUE(row: map<text, text>) -> int {
  300-0000014@[row, "qty", "0"] -> qty_text
  400-0000009@[qty_text, 0] -> qty
  300-0000014@[row, "price_cents", "0"] -> price_text
  400-0000009@[price_text, 0] -> price
  400-0000003@[qty, price] -> val
  return val
}

