phonebook 0.1

ext 000-0000001 FORMAT_ROW(row: map<text, text>) -> text {
  300-0000014@[row, "name", ""] -> name
  300-0000014@[row, "category", ""] -> cat
  300-0000001@[name, " (", cat, ")"] -> parts
  200-0000004@[parts, ""] -> formatted
  return formatted
}

500-0000003@["experiments/data/inventory.csv"] -> rows
300-0000003@[rows, 000-0000001] -> formatted_rows
300-0000005@[formatted_rows] -> sorted
100-0000002@[sorted]
