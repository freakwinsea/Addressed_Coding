ext 000-0000001 IS_ZERO_QTY(row: map<text, text>) -> bool {
  300-0000014@[row, "qty", ""] -> qty_text
  400-0000009@[qty_text, -1] -> qty
  600-0000004@[qty, 0] -> is_zero
  return is_zero
}

ext 000-0000002 GET_NAME(row: map<text, text>) -> text {
  300-0000014@[row, "name", ""] -> name
  return name
}

