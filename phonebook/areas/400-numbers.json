{
  "area": "400",
  "title": "Numbers",
  "description": "Integer and floating-point arithmetic. int is 64-bit signed; float is IEEE 754 binary64, always finite, with no negative zero. DIV and MOD pin the two places Python and Rust disagree about negative operands; ROUND pins where they disagree about halves; TO_TEXT pins how a float prints.",
  "entries": [
    {
      "address": "400-0000001",
      "name": "ADD",
      "summary": "Add two integers",
      "keywords": ["add", "plus", "sum", "increment", "total"],
      "contract": {
        "version": 1,
        "inputs": [{ "name": "a", "type": "int" }, { "name": "b", "type": "int" }],
        "output": { "name": "result", "type": "int" },
        "effects": [],
        "errors": ["overflow"],
        "purity": "pure",
        "determinism": "deterministic",
        "notes": ["Integers are 64-bit signed. Overflow is an error, not a wrap and not a promotion to arbitrary precision."]
      },
      "examples": ["400-0000001@[n, 1] -> next"],
      "conformance": [{ "id": "add.basic", "args": [2, 3], "expect": 5 }],
      "status": "active",
      "since": "0.1.0"
    },
