    {
      "address": "400-0000004",
      "name": "DIV",
      "summary": "Divide two integers, truncating toward zero",
      "description": "Integer division. The rounding direction is pinned by contract because the host languages disagree: Python's // floors toward negative infinity, Rust's / truncates toward zero. This address promises truncation, and every backend is held to it.",
      "keywords": ["divide", "division", "quotient", "over", "split"],
      "contract": {
        "version": 1,
        "inputs": [{ "name": "a", "type": "int" }, { "name": "b", "type": "int" }],
        "output": { "name": "result", "type": "int" },
        "effects": [],
        "errors": ["division_by_zero", "overflow"],
        "purity": "pure",
        "determinism": "deterministic",
        "notes": [
          "TRUNCATES TOWARD ZERO: -7 / 2 is -3, not -4.",
          "A Python backend must NOT use // here. This is the clearest example in the registry of a contract overriding a host language's default."
        ]
      },
      "examples": ["400-0000004@[total, n] -> mean"],
      "conformance": [
        { "id": "div.basic", "args": [7, 2], "expect": 3 },
        { "id": "div.negative_truncates", "args": [-7, 2], "expect": -3 },
        { "id": "div.negative_divisor", "args": [7, -2], "expect": -3 },
        { "id": "div.by_zero", "args": [1, 0], "expect": null, "raises": "division_by_zero" }
      ],
      "status": "active",
      "since": "0.1.0"
    },
    {
      "address": "400-0000005",
      "name": "MOD",
      "summary": "Remainder of integer division, taking the sign of the dividend",
      "description": "The companion to DIV: a == DIV(a,b) * b + MOD(a,b) always holds. Python's % takes the sign of the divisor, so a Python backend must not use it directly.",
      "keywords": ["mod", "modulo", "remainder", "rest", "percent"],
      "contract": {
        "version": 1,
        "inputs": [{ "name": "a", "type": "int" }, { "name": "b", "type": "int" }],
        "output": { "name": "result", "type": "int" },
        "effects": [],
        "errors": ["division_by_zero"],
        "purity": "pure",
        "determinism": "deterministic",
        "notes": [
          "SIGN OF THE DIVIDEND: -7 mod 2 is -1, not 1.",
          "Consistent with DIV (400-0000004) so that a == DIV(a,b)*b + MOD(a,b)."
        ]
      },
      "examples": ["400-0000005@[n, 2] -> parity"],
      "conformance": [
        { "id": "mod.basic", "args": [7, 2], "expect": 1 },
        { "id": "mod.negative_dividend", "args": [-7, 2], "expect": -1 },
        { "id": "mod.negative_divisor", "args": [7, -2], "expect": 1 },
        { "id": "mod.by_zero", "args": [1, 0], "expect": null, "raises": "division_by_zero" }
      ],
      "status": "active",
      "since": "0.1.0"
    },
