    {
      "address": "400-0000015",
      "name": "ADD_FLOAT",
      "summary": "Add two floats",
      "keywords": ["add", "plus", "sum", "float", "decimal", "real"],
      "contract": {
        "version": 1,
        "inputs": [{ "name": "a", "type": "float" }, { "name": "b", "type": "float" }],
        "output": { "name": "result", "type": "float" },
        "effects": [],
        "errors": ["overflow"],
        "purity": "pure",
        "determinism": "deterministic",
        "notes": [
          "float is IEEE 754 binary64. The result is the exact sum rounded to nearest, ties to even, which every backend gets from its hardware.",
          "FINITE ONLY: a result too large to be finite is an overflow error. NaN and infinity never exist as values.",
          "NO NEGATIVE ZERO: a result of -0.0 is 0.0."
        ]
      },
      "examples": ["400-0000015@[price, tax] -> total"],
      "conformance": [
        { "id": "add_float.basic", "args": [1.5, 2.25], "expect": 3.75 },
        { "id": "add_float.binary_rounding", "args": [0.1, 0.2], "expect": 0.30000000000000004 },
        { "id": "add_float.overflow", "args": [1.7976931348623157e308, 1.7976931348623157e308], "expect": null, "raises": "overflow" }
      ],
      "status": "active",
      "since": "0.2.0"
    },
