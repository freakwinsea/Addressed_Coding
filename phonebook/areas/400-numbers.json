    {
      "address": "400-0000010",
      "name": "ABS",
      "summary": "The distance of an integer from zero",
      "keywords": ["abs", "absolute", "magnitude", "distance", "unsigned"],
      "contract": {
        "version": 1,
        "inputs": [{ "name": "a", "type": "int" }],
        "output": { "name": "result", "type": "int" },
        "effects": [],
        "errors": ["overflow"],
        "purity": "pure",
        "determinism": "deterministic",
        "notes": [
          "The absolute value of the smallest 64-bit integer does not fit, so ABS(-9223372036854775808) is an overflow error. Python's abs would quietly return a bigger number; Rust's abs would panic or wrap by build profile."
        ]
      },
      "examples": ["400-0000010@[delta] -> distance"],
      "conformance": [
        { "id": "abs.positive", "args": [5], "expect": 5 },
        { "id": "abs.negative", "args": [-5], "expect": 5 },
        { "id": "abs.zero", "args": [0], "expect": 0 },
        { "id": "abs.max", "args": [9223372036854775807], "expect": 9223372036854775807 },
        { "id": "abs.min_overflows", "args": [-9223372036854775808], "expect": null, "raises": "overflow" }
      ],
      "status": "active",
      "since": "0.2.0"
    },
    {
